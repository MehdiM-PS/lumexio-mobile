{
    "name": "lumexio/native-line-chart",
    "description": "Smooth native line/area chart EDGE component for NativePHP Mobile, matching the Lumexio web app's forecast chart.",
    "type": "nativephp-ui-plugin",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Lumexio\\NativeLineChart\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Lumexio\\NativeLineChart\\NativeLineChartServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    }
}
